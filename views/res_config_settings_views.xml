<odoo>
    <!-- Paramètres › Activité : tout ce qui se règle pour l'ensemble de la société, au même endroit. -->
    <record id="res_config_settings_view_form_mission_report" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.mission.report</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="95"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Activity" name="mission_report">
                    <block title="Billing" name="mission_billing_block">
                        <setting id="mission_billing_unit_default" company_dependent="1"
                                 string="Default billing"
                                 help="Unit of the new mission orders: validated days or hours. Each order can change it.">
                            <field name="mission_billing_unit_default" widget="radio"
                                   options="{'horizontal': true}"/>
                        </setting>
                        <setting id="mission_hours_outside_schedule" company_dependent="1"
                                 string="Hours outside working hours"
                                 help="An entry in hours counts all the hours entered. Unticked, only those of the working schedule of the employee count.">
                            <field name="mission_hours_outside_schedule"/>
                        </setting>
                    </block>

                    <block title="Profitability" name="mission_profitability_block">
                        <setting id="mission_cost_coefficient" company_dependent="1"
                                 string="Wage coefficient"
                                 help="Multiplied by the gross monthly wage of the HR contract to give the cost of an employee for the company: 1.45 adds employer charges of 45 %. The cost of a day is that cost divided by the working days of the month. Shown in the profitability panel of the projects, to the managers.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="mission_cost_coefficient" class="col-lg-4 o_light_label"/>
                                    <field name="mission_cost_coefficient"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Margin calculations" name="mission_margin_block">
                        <setting id="mission_margin_rates" company_dependent="1" class="col-lg-12"
                                 string="Rates of the company"
                                 help="Copied into each margin calculation, which cannot change them: a change here applies to the calculations made afterwards.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="mission_employer_charge_rate" class="col-lg-4 o_light_label"/>
                                    <field name="mission_employer_charge_rate" widget="percentage"/>
                                </div>
                                <div class="row">
                                    <label for="mission_employee_charge_rate" class="col-lg-4 o_light_label"/>
                                    <field name="mission_employee_charge_rate" widget="percentage"/>
                                </div>
                                <div class="row">
                                    <label for="mission_overhead_rate" class="col-lg-4 o_light_label"/>
                                    <field name="mission_overhead_rate" widget="percentage"/>
                                </div>
                                <div class="row">
                                    <label for="mission_salary_min" class="col-lg-4 o_light_label"/>
                                    <field name="mission_salary_min"/>
                                </div>
                                <div class="row">
                                    <label for="mission_salary_max" class="col-lg-4 o_light_label"/>
                                    <field name="mission_salary_max"/>
                                </div>
                            </div>
                        </setting>
                        <setting id="mission_margin_commissions" company_dependent="1" class="col-lg-12"
                                 string="Commissions"
                                 help="The conditions to earn a commission and the rates of each status of salesperson. The status is chosen on each margin calculation.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="mission_show_commissions" class="col-lg-4 o_light_label"/>
                                    <field name="mission_show_commissions"/>
                                </div>
                                <div class="row">
                                    <label for="mission_commission_threshold_rate" class="col-lg-4 o_light_label"/>
                                    <field name="mission_commission_threshold_rate" widget="percentage"/>
                                </div>
                                <div class="row">
                                    <label for="mission_commission_threshold_amount" class="col-lg-4 o_light_label"/>
                                    <field name="mission_commission_threshold_amount"/>
                                </div>
                                <div class="row">
                                    <label for="mission_commission_cap" class="col-lg-4 o_light_label"/>
                                    <field name="mission_commission_cap" widget="percentage"/>
                                </div>
                                <field name="mission_commission_rule_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="name"/>
                                        <field name="rate_sourcing" widget="percentage" string="Sourcing"/>
                                        <field name="rate_referral" widget="percentage" string="Referral"/>
                                        <field name="rate_candidate" widget="percentage" string="Candidate side"/>
                                        <field name="rate_client" widget="percentage" string="Client side"/>
                                        <field name="rate_full" widget="percentage" string="Full"/>
                                        <field name="rate_team" widget="percentage" string="Collaborators"/>
                                        <field name="partners_only"/>
                                    </list>
                                </field>
                            </div>
                        </setting>
                    </block>

                    <block title="Long-distance allowances" name="mission_igd_scale_block">
                        <setting id="mission_igd_scale" company_dependent="1"
                                 string="Scale of the allowances (URSSAF)"
                                 help="Meal and lodging allowances per day worked, by month of the mission: the reference scale of the company. Each margin calculation takes a copy of it, which can be edited for that mission only.">
                            <field name="mission_igd_rate_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="month_from"/>
                                    <field name="month_to"/>
                                    <field name="meal"/>
                                    <field name="lodging"/>
                                    <field name="total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </setting>
                    </block>

                    <block title="Reminders" name="mission_reminder_block">
                        <setting id="mission_reminder_day" company_dependent="1"
                                 string="Report reminders"
                                 help="The day of the month on which each employee who entered a mission gets the task &quot;Submit your report&quot;, then their manager &quot;Validate the report&quot;. 0: no reminder.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="mission_reminder_day" class="col-lg-4 o_light_label"/>
                                    <field name="mission_reminder_day"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Long-distance travel allowances (IGD)" name="mission_igd_block">
                        <setting id="mission_igd_categories" class="col-lg-12" string="Expense categories of the IGD"
                                 help="The Expenses categories that &quot;Generate the IGD&quot; uses. The planned monthly amount is set on the form of each mission.">
                            <div class="content-group">
                                <div class="row mt16">
                                    <label for="igd_lodging_product_id" class="col-lg-4 o_light_label"/>
                                    <field name="igd_lodging_product_id" options="{'no_create': True}"/>
                                </div>
                                <div class="row">
                                    <label for="igd_meal_product_id" class="col-lg-4 o_light_label"/>
                                    <field name="igd_meal_product_id" options="{'no_create': True}"/>
                                </div>
                                <div class="row">
                                    <label for="igd_expat_product_id" class="col-lg-4 o_light_label"/>
                                    <field name="igd_expat_product_id" options="{'no_create': True}"/>
                                </div>
                                <div class="row">
                                    <label for="igd_real_meal_product_ids" class="col-lg-4 o_light_label"/>
                                    <field name="igd_real_meal_product_ids" widget="many2many_tags"
                                           options="{'no_create': True}"/>
                                </div>
                            </div>
                        </setting>
                    </block>

                    <block title="Public holidays and reports" name="mission_tools_block">
                        <setting id="mission_public_holidays" string="French public holidays"
                                 help="To generate for each year before preparing a phase: without them, public holidays would count as working days.">
                            <div class="content-group">
                                <button name="%(mission_report.action_mission_public_holiday_wizard)d"
                                        type="action" string="Generate public holidays"
                                        class="btn-link ps-0" icon="oi-arrow-right"/>
                            </div>
                        </setting>
                        <setting id="mission_report_templates" string="Excel templates of the reports"
                                 help="The workbook the reports are exported to: download it, give it your own look, upload it again.">
                            <div class="content-group">
                                <button name="%(mission_report.action_mission_activity_report_template)d"
                                        type="action" string="Excel templates"
                                        class="btn-link ps-0" icon="oi-arrow-right"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
