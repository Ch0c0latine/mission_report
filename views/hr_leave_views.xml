<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Formulaire : réorganisation et renommage des champs et libellés -->
    <record id="hr_leave_view_form_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.mission.report</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <!-- Reorder fields: Mission (project_id), Congé (holiday_status_id), Employé (employee_id) -->
            <xpath expr="//field[@name='holiday_status_id']" position="before">
                <field name="project_id" string="Mission"/>
            </xpath>

            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="employee_id" position="move"/>
            </xpath>

            <!-- Relabel holiday_status_id to "Congé" -->
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="string">Congé</attribute>
            </xpath>

            <!-- Rename approve button in form view ("Approuver" / validation -> "Valider") -->
            <xpath expr="//button[@name='action_approve']" position="attributes">
                <attribute name="string">Valider</attribute>
            </xpath>

            <!-- Rename delete/refuse action button ("Refuser" -> "Supprimer") -->
            <xpath expr="//button[@name='action_refuse']" position="attributes">
                <attribute name="string">Supprimer</attribute>
            </xpath>
        </field>
    </record>

    <!-- Vue Liste : ajout project_id et masquage du bouton "Nouveaux congés de groupe" -->
    <record id="hr_leave_view_tree_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.view.list.inherit.mission.report</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="project_id" string="Mission" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="string">Congé</attribute>
            </xpath>
            <!-- Hide "Nouveaux congés de groupe" header button -->
            <xpath expr="//header/button" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Vue Calendrier : ajout project_id, renommage et masquage du bouton "Nouveaux congés de groupe" -->
    <record id="hr_leave_view_calendar_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.view.calendar.inherit.mission.report</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="inside">
                <field name="project_id"/>
            </xpath>
            <!-- Hide "Nouveaux congés de groupe" header button in calendar view -->
            <xpath expr="//header//button[@name='%(hr_holidays.action_hr_leave_generate_multi_wizard)d' or contains(@string, 'groupe') or contains(@string, 'Groupe') or contains(@string, 'Group')]" position="attributes" raise_if_not_found="false">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='%(hr_holidays.action_hr_leave_generate_multi_wizard)d' or contains(@string, 'groupe') or contains(@string, 'Groupe') or contains(@string, 'Group')]" position="attributes" raise_if_not_found="false">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
