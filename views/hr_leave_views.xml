<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Formulaire : Réorganisation des champs et modification des libellés -->
    <record id="hr_leave_view_form_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.mission.report</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <!-- Déplacer employee_id au début et ajouter project_id avant holiday_status_id -->
            <xpath expr="//field[@name='holiday_status_id']" position="before">
                <field name="employee_id" position="move"/>
                <field name="project_id" string="Mission"/>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="string">Congé</attribute>
                <attribute name="required">0</attribute>
            </xpath>

            <!-- Modifier le bouton Soumettre ("action_confirm") en "Valider" -->
            <xpath expr="//button[@name='action_confirm']" position="attributes">
                <attribute name="string">Valider</attribute>
            </xpath>
        </field>
    </record>

    <!-- Vue Liste : ajout project_id et réorganisation -->
    <record id="hr_leave_view_tree_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.view.list.inherit.mission.report</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="project_id" string="Mission" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Vue Calendrier : Titre de la popup et affichage project_id -->
    <record id="hr_leave_view_calendar_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.view.calendar.inherit.mission.report</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_calendar"/>
        <field name="arch" type="xml">
            <xpath expr="//calendar" position="attributes">
                <attribute name="event_open_popup">true</attribute>
                <attribute name="string">Saisie d'activité</attribute>
            </xpath>
            <xpath expr="//calendar" position="inside">
                <field name="project_id" string="Mission"/>
            </xpath>
        </field>
    </record>
</odoo>
