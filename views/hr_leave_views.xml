<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue Formulaire : réorganisation et renommage des champs et libellés -->
    <record id="hr_leave_view_form_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.mission.report</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <!-- Titre du formulaire -->
            <xpath expr="//form" position="attributes">
                <attribute name="string">Saisie d'activité</attribute>
            </xpath>

            <!-- Bascule rapide Mission / Congé, tout en haut du formulaire, avant tout le reste
                 (Mission = valeur par défaut). Boutons radio : contrairement à boolean_toggle, ça
                 n'enregistre pas instantanément au clic (ce qui entrait en course avec la mise à
                 jour de Mission/Congé et déclenchait l'erreur de validation). -->
            <xpath expr="//div[@name='title']" position="before">
                <field name="entry_type" widget="radio" options="{'horizontal': true}" nolabel="1" class="mb-2"/>
            </xpath>

            <!-- Mission (+ Client dérivé), visible seulement en mode Mission -->
            <xpath expr="//field[@name='holiday_status_id']" position="before">
                <field name="project_id" string="Mission" invisible="entry_type != 'mission'"/>
                <field name="partner_id" string="Client" invisible="entry_type != 'mission' or not project_id"/>
            </xpath>

            <!-- Congé : renommage + visible seulement en mode Congé -->
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="string">Congé</attribute>
                <attribute name="invisible">entry_type != 'leave'</attribute>
            </xpath>

            <!-- Employé : rendu visible et repositionné après Congé -->
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="after">
                <field name="employee_id" position="move"/>
            </xpath>

            <!-- Masque l'en-tête (statut d'approbation, Valider/Refuser) : hors sujet pour ce formulaire
                 de saisie simple, et source de confusion avec notre propre pied de page. -->
            <xpath expr="//header" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <!-- Masque le panneau de résumé/statistiques (colonne de droite) : sans intérêt ici,
                 et élargit la colonne de gauche restante à toute la largeur. -->
            <xpath expr="//div[hasclass('col_right')]" position="replace"/>
            <xpath expr="//div[hasclass('col_left')]" position="attributes">
                <attribute name="class" remove="col-md-6" separator=" "/>
            </xpath>

            <!-- Pied de page dédié : remplace les boutons génériques de la popup de création/édition.
                 action_delete_entry renvoie False (au lieu du signal de fermeture explicite testé
                 précédemment) pour voir si cette popup calendrier évite le rechargement de
                 l'enregistrement supprimé. -->
            <xpath expr="//chatter" position="after">
                <footer>
                    <button string="Enregistrer" special="save" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                    <button string="Supprimer le congé" name="action_delete_entry" type="object"
                            confirm="Voulez-vous vraiment supprimer cette saisie ?"
                            class="btn-link text-danger ms-auto"
                            invisible="not id"/>
                </footer>
            </xpath>
        </field>
    </record>

    <!-- Vue Liste : ajout project_id, modification du nom "Demandes en attente" par "Saisies en attente" et masquage du bouton "Nouveaux congés de groupe" -->
    <record id="hr_leave_view_tree_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.view.list.inherit.mission.report</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="project_id" string="Mission" optional="show"/>
                <field name="partner_id" string="Client" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="string">Congé</attribute>
            </xpath>
            <!-- Hide "Nouveaux congés de groupe" header button -->
            <xpath expr="//header/button" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Vue Calendrier (celle réellement utilisée par le menu Activité : js_class=time_off_calendar_dashboard,
         confirmée via l'inspecteur de vue Odoo) : ajout project_id -->
    <record id="hr_leave_view_calendar_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.view.calendar.inherit.mission.report</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_dashboard"/>
        <field name="arch" type="xml">
            <!-- Titre de la popup de création/édition (dérivé de cet attribut, pas du form) + formulaire
                 dédié utilisé (au lieu de la popup "dashboard" de hr_holidays qui masque l'en-tête et
                 duplique le champ Employé) -->
            <xpath expr="//calendar" position="attributes">
                <attribute name="string">Saisie d'activité</attribute>
                <attribute name="form_view_id">%(hr_holidays.hr_leave_view_form)d</attribute>
            </xpath>
            <xpath expr="//calendar" position="inside">
                <field name="project_id"/>
            </xpath>
        </field>
    </record>
</odoo>
