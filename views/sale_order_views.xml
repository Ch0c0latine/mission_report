<odoo>
    <!-- Ventes : les personnes en mission sur chaque affaire, pour s'y repérer. -->
    <record id="sale_order_tree_mission_employees" model="ir.ui.view">
        <field name="name">sale.order.list.mission.employees</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="mission_employee_names" optional="show"/>
            </field>
            <!-- La colonne « Date de livraison » : celle de la commande, sinon la fin de l'affaire. -->
            <field name="commitment_date" position="replace">
                <field name="mission_delivery_date" string="Date de livraison" optional="show"/>
            </field>
        </field>
    </record>
</odoo>
