<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Affaire : « Nouveau volet » crée l'affaire suivante de la mission ; la page
         Prestation porte les textes du devis, les lignes leur période. -->
    <record id="view_order_form_mission_volet" model="ir.ui.view">
        <field name="name">sale.order.form.mission.volet</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_cancel']" position="after">
                <button name="action_mission_new_volet" type="object" string="Nouveau volet"
                        invisible="not project_id or state == 'cancel'"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="mission_period_start" optional="hide"/>
                <field name="mission_period_end" optional="hide"/>
            </xpath>
            <xpath expr="//page[@name='order_lines']" position="after">
                <page string="Prestation" name="mission_prestation">
                    <button name="action_mission_fill_from_note" type="object" class="btn-secondary"
                            string="Reprendre depuis la note"
                            invisible="mission_description or mission_expenses_text or not note"/>
                    <group>
                        <group>
                            <field name="mission_volet_number" invisible="not mission_volet_number and not project_id"/>
                        </group>
                    </group>
                    <separator string="Description de la prestation"/>
                    <field name="mission_description" nolabel="1"
                           placeholder="Objet, lieu et déroulement de la prestation, imprimés sur le devis sous le titre du volet."/>
                    <separator string="Frais"/>
                    <field name="mission_expenses_text" nolabel="1"
                           placeholder="Les frais de déplacement seront facturés au réel sur présentation des justificatifs."/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="mission_volet_wizard_view_form" model="ir.ui.view">
        <field name="name">mission.volet.wizard.form</field>
        <field name="model">mission.volet.wizard</field>
        <field name="arch" type="xml">
            <form string="Nouveau volet">
                <field name="order_id" invisible="1"/>
                <field name="needs_source_dates" invisible="1"/>
                <group>
                    <group string="Nouveau volet">
                        <field name="date_start" string="Début"/>
                        <field name="date_end" string="Fin"/>
                        <field name="employee_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <field name="mission_billing_unit" widget="radio" options="{'horizontal': true}"/>
                    </group>
                    <group string="Affaire d'origine">
                        <field name="source_date_start" string="Début" readonly="1" force_save="1"/>
                        <field name="source_date_end" string="Fin" readonly="1" force_save="1"/>
                        <div class="text-muted" colspan="2" invisible="not needs_source_dates">
                            Dates absentes de l'affaire : celles-ci y seront enregistrées.
                        </div>
                        <div class="text-muted" colspan="2" invisible="needs_source_dates">
                            À modifier, si besoin, dans l'affaire elle-même.
                        </div>
                    </group>
                </group>
                <div class="alert alert-warning" role="alert" invisible="not warning">
                    <field name="warning"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not unit_warning">
                    <field name="unit_warning"/>
                </div>
                <div class="alert alert-warning" role="alert" invisible="not note_warning">
                    <field name="note_warning"/>
                </div>
                <field name="plan" nolabel="1" readonly="1"/>
                <footer>
                    <button name="action_create" type="object" string="Créer le volet" class="btn-primary"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
