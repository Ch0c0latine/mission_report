<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- IGD : réservé aux administrateurs, rien n'est imprimé. -->
    <!-- Dépenses > Générer les IGD : chaque salarié pour le mois en cours, un
         responsable pour son équipe. -->
    <record id="mission_igd_wizard_view_form" model="ir.ui.view">
        <field name="name">mission.igd.wizard.form</field>
        <field name="model">mission.igd.wizard</field>
        <field name="arch" type="xml">
            <form string="Générer les IGD">
                <field name="state" invisible="1"/>
                <field name="created_expense_ids" invisible="1"/>
                <field name="missing_employee_ids" invisible="1"/>
                <group invisible="state != 'choose'">
                    <field name="employee_ids" widget="many2many_tags"
                           groups="hr_expense.group_hr_expense_team_approver"/>
                    <label for="report_month" string="Mois"/>
                    <div class="o_row">
                        <field name="report_month"/>
                        <field name="report_year"/>
                    </div>
                </group>
                <field name="result" nolabel="1" invisible="state != 'done'"/>
                <footer>
                    <button name="action_generate" type="object" string="Générer" class="btn-primary"
                            invisible="state != 'choose'"/>
                    <button name="action_open_expenses" type="object" string="Voir les IGD créées"
                            class="btn-primary" invisible="state != 'done' or not created_expense_ids"/>
                    <button name="action_open_entries" type="object" string="Ouvrir la saisie des temps"
                            class="btn-primary" invisible="state != 'done' or not missing_employee_ids"/>
                    <button string="Annuler" special="cancel" invisible="state != 'choose'"/>
                    <button string="Fermer" special="cancel" invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mission_igd_wizard" model="ir.actions.act_window">
        <field name="name">Générer les IGD</field>
        <field name="res_model">mission.igd.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_mission_igd" name="Générer les IGD"
              parent="hr_expense.menu_hr_expense_my_expenses"
              action="action_mission_igd_wizard" sequence="12"/>

    <!-- Filtre IGD dans les dépenses. -->
    <record id="hr_expense_view_search_igd" model="ir.ui.view">
        <field name="name">hr.expense.view.search.igd</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='invoiced']" position="after">
                <filter string="IGD" name="igd" domain="[('product_id.igd_category', '=', True)]"/>
                <filter string="Sans IGD" name="no_igd" domain="[('product_id.igd_category', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="project_project_view_form_igd" model="ir.ui.view">
        <field name="name">project.project.form.igd</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='settings']/group" position="inside">
                <group name="igd" string="IGD" groups="base.group_system">
                    <field name="igd_currency_id" invisible="1"/>
                    <field name="igd_monthly_budget"/>
                    <field name="igd_start" invisible="not igd_monthly_budget"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="res_company_view_form_igd" model="ir.ui.view">
        <field name="name">res.company.form.igd</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="igd" string="IGD" groups="base.group_system">
                    <group>
                        <field name="igd_lodging_product_id"/>
                        <field name="igd_meal_product_id"/>
                        <field name="igd_expat_product_id"/>
                        <field name="igd_real_meal_product_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
