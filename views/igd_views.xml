<odoo>
    <!-- IGD : réservé aux administrateurs, rien n'est imprimé. -->
    <!-- Dépenses > Générer les IGD : chaque salarié pour le mois en cours, un
         responsable pour son équipe. -->
    <record id="mission_igd_wizard_view_form" model="ir.ui.view">
        <field name="name">mission.igd.wizard.form</field>
        <field name="model">mission.igd.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate the IGD">
                <field name="state" invisible="1"/>
                <field name="created_expense_ids" invisible="1"/>
                <field name="missing_employee_ids" invisible="1"/>
                <group invisible="state != 'choose'">
                    <field name="employee_ids" widget="many2many_tags"
                           groups="hr_expense.group_hr_expense_team_approver"/>
                    <label for="report_month" string="Month"/>
                    <div class="o_row">
                        <field name="report_month"/>
                        <field name="report_year"/>
                    </div>
                </group>
                <field name="result" nolabel="1" invisible="state != 'done'"/>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"
                            invisible="state != 'choose'"/>
                    <button name="action_open_expenses" type="object" string="See the IGD created"
                            class="btn-primary" invisible="state != 'done' or not created_expense_ids"/>
                    <button name="action_open_entries" type="object" string="Open the time entry"
                            class="btn-primary" invisible="state != 'done' or not missing_employee_ids"/>
                    <button string="Cancel" special="cancel" invisible="state != 'choose'"/>
                    <button string="Close" special="cancel" invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_mission_igd_wizard" model="ir.actions.act_window">
        <field name="name">Generate the IGD</field>
        <field name="res_model">mission.igd.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_mission_igd" name="Generate the IGD"
              parent="hr_expense.menu_hr_expense_my_expenses"
              action="action_mission_igd_wizard" sequence="12"/>

    <!-- Filtre IGD dans les dépenses. -->
    <record id="hr_expense_view_search_igd" model="ir.ui.view">
        <field name="name">hr.expense.view.search.igd</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_search"/>
        <field name="arch" type="xml">
            <!-- Leur propre groupe : « IGD » se combine avec les autres filtres, il ne s'y ajoute pas.
                 Ancré sur un filtre d'Odoo (hr_expense), présent que expense_scan soit installé ou non. -->
            <xpath expr="//filter[@name='to_pay']" position="after">
                <separator/>
                <filter string="IGD" name="igd" domain="[('product_id.igd_category', '=', True)]"/>
                <filter string="No IGD" name="no_igd" domain="[('product_id.igd_category', '=', False)]"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <record id="project_project_view_form_igd" model="ir.ui.view">
        <field name="name">project.project.form.igd</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <!-- Sous les champs principaux de la fiche, pas dans l'onglet Paramètres. -->
            <xpath expr="//notebook" position="before">
                <group name="igd" string="Long-distance travel allowances (IGD)" groups="base.group_system">
                    <field name="igd_currency_id" invisible="1"/>
                    <field name="igd_monthly_budget"/>
                    <field name="igd_start" invisible="not igd_monthly_budget"/>
                    <field name="igd_lodging_basis" widget="radio" options="{'horizontal': true}"
                           invisible="not igd_monthly_budget"/>
                    <field name="igd_meal_basis" widget="radio" options="{'horizontal': true}"
                           invisible="not igd_monthly_budget"/>
                    <field name="igd_adjustment_ids" colspan="2" nolabel="1"
                           invisible="not igd_monthly_budget"
                           context="{'default_project_id': id}">
                        <list editable="bottom">
                            <field name="employee_id"/>
                            <field name="month" widget="date" options="{'format': 'MM/yyyy'}"/>
                            <field name="amount"/>
                            <field name="currency_id" column_invisible="1"/>
                            <field name="reason"/>
                        </list>
                    </field>
                    <field name="igd_position_ids" colspan="2" invisible="not igd_monthly_budget">
                        <list create="0" delete="0" decoration-warning="balance &gt; 0" decoration-info="balance &lt; 0">
                            <field name="employee_id"/>
                            <field name="last_month" widget="date" options="{'format': 'MM/yyyy'}" optional="hide"/>
                            <field name="months" optional="hide"/>
                            <field name="balance"/>
                            <field name="quota"/>
                            <field name="adjustment"/>
                            <field name="paid"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    <div colspan="2" invisible="not igd_monthly_budget">
                        <button name="action_igd_refresh_position" type="object" class="btn btn-secondary btn-sm"
                                string="Update the situation"/>
                    </div>
                    <div class="text-muted" colspan="2">
                        "Generate the IGD" (Expenses application) uses it to create the IGD of the month.
                        An adjustment adds (or removes) its amount to the quota of the month it targets, without being carried over to the following months.
                    </div>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
