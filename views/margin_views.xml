<odoo>
    <record id="mission_margin_view_list" model="ir.ui.view">
        <field name="name">mission.margin.list</field>
        <field name="model">mission.margin</field>
        <field name="arch" type="xml">
            <list string="Margin calculations">
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="consultant" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="daily_rate" optional="show"/>
                <field name="margin_month" optional="show"/>
                <field name="margin_rate" widget="percentage" optional="show"/>
                <field name="margin_duration" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="mission_margin_view_search" model="ir.ui.view">
        <field name="name">mission.margin.search</field>
        <field name="model">mission.margin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="consultant"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="order_id"/>
                <filter name="without_order" string="Without order" domain="[('order_id', '=', False)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mission_margin_view_form" model="ir.ui.view">
        <field name="name">mission.margin.form</field>
        <field name="model">mission.margin</field>
        <field name="arch" type="xml">
            <form string="Margin calculation">
                <field name="currency_id" invisible="1"/>
                <field name="active" invisible="1"/>
                <field name="name_auto" invisible="1"/>
                <header>
                    <button name="action_create_project" type="object" string="Create the project"
                            invisible="project_id"/>
                    <button name="action_create_order" type="object" string="Create the quote"
                            class="oe_highlight" invisible="order_id or not partner_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_project" type="object" class="oe_stat_button"
                                icon="fa-puzzle-piece" invisible="not project_id">
                            <div class="o_stat_info"><span class="o_stat_text">Project</span></div>
                        </button>
                        <button name="action_open_order" type="object" class="oe_stat_button"
                                icon="fa-dollar" invisible="not order_id">
                            <div class="o_stat_info"><span class="o_stat_text">Order</span></div>
                        </button>
                        <button name="action_open_profitability" type="object" class="oe_stat_button"
                                icon="fa-line-chart" invisible="not project_id"
                                groups="project.group_project_user">
                            <div class="o_stat_info"><span class="o_stat_text">Actual profitability</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Filled in from the customer and the consultant"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="consultant"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <field name="salary_min" invisible="1"/>
                    <field name="salary_max" invisible="1"/>
                    <field name="show_commissions" invisible="1"/>
                    <field name="rate_manual" invisible="1"/>
                    <field name="cost_per_day" invisible="1"/>
                    <field name="rebilled_total" invisible="1"/>
                    <group>
                        <group string="The consultant">
                            <field name="cost_origin" widget="radio" options="{'horizontal': true}"/>
                            <div colspan="2" invisible="cost_origin != 'employee'">
                                <field name="gross_salary" widget="salary_slider" nolabel="1"/>
                            </div>
                            <field name="gross_salary" invisible="cost_origin != 'employee'"/>
                            <field name="freelance_daily_rate" invisible="cost_origin != 'freelance'"/>
                            <label for="igd_lodging" string="Allowances per day worked"
                                   invisible="cost_origin != 'employee'"/>
                            <div class="d-flex flex-wrap align-items-center gap-4" invisible="cost_origin != 'employee'">
                                <span class="d-inline-flex align-items-center gap-1">
                                    <field name="igd_lodging" nolabel="1"/><label for="igd_lodging"/>
                                </span>
                                <span class="d-inline-flex align-items-center gap-1">
                                    <field name="igd_lunch" nolabel="1"/><label for="igd_lunch"/>
                                </span>
                                <span class="d-inline-flex align-items-center gap-1">
                                    <field name="igd_dinner" nolabel="1"/><label for="igd_dinner"/>
                                </span>
                            </div>
                            <label for="igd_scale_choice" invisible="cost_origin != 'employee'
                                   or not (igd_lodging or igd_lunch or igd_dinner)"/>
                            <field name="igd_scale_choice" invisible="cost_origin != 'employee'
                                   or not (igd_lodging or igd_lunch or igd_dinner)"/>
                            <label for="igd_daily" string="Allowances total"
                                   invisible="cost_origin != 'employee' or not igd_daily"/>
                            <div class="d-flex flex-wrap align-items-center gap-2 fw-bold"
                                 invisible="cost_origin != 'employee' or not igd_daily">
                                <field name="igd_daily" class="oe_inline"/> <div>a day</div>
                                <div class="text-muted">-</div>
                                <field name="igd_month" class="oe_inline"/> <div>a month</div>
                            </div>
                            <label for="daily_cost_worked" invisible="cost_origin != 'employee'"/>
                            <div class="d-flex gap-2" invisible="cost_origin != 'employee'">
                                <field name="daily_cost_worked" class="o_margin_amount"/>
                                <field name="daily_cost_reason" placeholder="Reason" class="flex-grow-1"/>
                            </div>
                            <label for="fixed_monthly_amount" invisible="cost_origin != 'employee'"/>
                            <div class="d-flex gap-2" invisible="cost_origin != 'employee'">
                                <field name="fixed_monthly_amount" class="o_margin_amount"/>
                                <field name="fixed_monthly_reason" placeholder="Reason" class="flex-grow-1"/>
                            </div>
                            <field name="duration_months"/>
                        </group>
                        <group string="Price and margin">
                            <field name="margin_wanted" widget="margin_slider"/>
                            <field name="margin_rate" widget="percentage" class="fw-bold"/>
                            <field name="margin_month" class="text-muted"/>
                            <field name="daily_rate" class="fw-bold"/>
                            <div class="text-muted" colspan="2" invisible="not rate_manual">
                                Rate typed by hand: move the slider to give the control back to the margin.
                            </div>
                            <label for="target_rate_2" string="Indicative daily rate" class="text-muted"/>
                            <div class="d-flex flex-wrap align-items-center gap-2 text-muted">
                                <field name="target_rate_2" widget="percentage" class="o_margin_pct"/>
                                <div>&#8594;</div> <field name="rate_target_rate_2" class="oe_inline fw-bold"/>
                                <field name="target_amount_2" class="o_margin_amount"/>
                                <div>a month</div> <div>&#8594;</div>
                                <field name="rate_target_2" class="oe_inline fw-bold"/>
                            </div>
                            <field name="rebilled_daily"/>
                            <field name="rebilled_monthly"/>
                            <field name="igd_rebilled" invisible="cost_origin != 'employee' or not igd_daily"/>
                        </group>
                    </group>

                    <group string="Where a month of billing goes">
                        <field name="breakdown" widget="margin_donut" nolabel="1" colspan="2"/>
                    </group>

                    <notebook>
                        <page string="Details of the costs" name="cost">
                            <group>
                                <group string="Other costs">
                                    <field name="other_worked_daily"/>
                                    <field name="daily_cost_calendar"/>
                                    <field name="expenses_monthly"/>
                                    <field name="mileage_monthly" invisible="cost_origin != 'employee'"/>
                                    <field name="training_yearly" invisible="cost_origin != 'employee'"/>
                                    <field name="ppe_yearly" invisible="cost_origin != 'employee'"/>
                                    <field name="equipment_yearly" invisible="cost_origin != 'employee'"/>
                                    <field name="other_yearly"/>
                                    <field name="other_costs"/>
                                </group>
                                <group string="Total">
                                    <field name="total_cost"/>
                                    <field name="total_cost_month"/>
                                    <field name="cost_per_day" string="Total cost per worked day"/>
                                    <field name="revenue"/>
                                    <field name="price_per_day"/>
                                    <field name="margin"/>
                                    <field name="margin_day"/>
                                    <field name="margin_duration" string="Margin over the mission"/>
                                </group>
                            </group>
                            <group>
                                <group string="Pay and charges">
                                    <field name="employer_charge_rate" widget="percentage" class="o_margin_pct text-muted"
                                           invisible="cost_origin != 'employee'"/>
                                    <field name="payslip_monthly_cost" invisible="cost_origin != 'employee'"/>
                                    <field name="overhead_rate" widget="percentage" class="o_margin_pct text-muted"/>
                                    <field name="base_cost"/>
                                    <field name="overhead_cost"/>
                                    <field name="loaded_cost"/>
                                </group>
                                <group string="Days worked">
                                    <field name="weekend_days"/>
                                    <field name="public_holidays"/>
                                    <field name="paid_leave_days"/>
                                    <field name="rtt_days"/>
                                    <field name="days_per_year"/>
                                    <field name="days_per_month"/>
                                </group>
                            </group>
                        </page>
                        <page string="Net income" name="net" invisible="cost_origin != 'employee'">
                            <group>
                                <group string="Consultant">
                                    <field name="gross_salary" readonly="1"/>
                                    <field name="employee_charge_rate" widget="percentage" class="o_margin_pct text-muted"/>
                                    <field name="net_salary_month"/>
                                    <field name="net_salary_day"/>
                                    <field name="daily_fees_month"/>
                                    <field name="daily_fees_day"/>
                                    <field name="net_income_month"/>
                                    <field name="net_income_day"/>
                                    <field name="net_income_year"/>
                                </group>
                            </group>
                        </page>
                        <page string="Commissions" name="commissions" invisible="not show_commissions">
                            <group>
                                <group string="Conditions">
                                    <field name="commission_threshold_rate" widget="percentage" class="o_margin_pct text-muted"/>
                                    <field name="commission_threshold_amount" class="text-muted"/>
                                    <field name="commission_eligible"/>
                                </group>
                                <group string="Gross commission a month">
                                    <field name="commission_rule_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="commission_rate_full" widget="percentage" class="o_margin_pct text-muted"/>
                                    <field name="commission_full"/>
                                    <field name="commission_rate_management" widget="percentage" class="o_margin_pct text-muted"/>
                                    <field name="commission_management"/>
                                    <field name="commission_rate_referral" widget="percentage" class="o_margin_pct text-muted"/>
                                    <field name="commission_referral"/>
                                </group>
                            </group>
                            <p class="text-muted" invisible="commission_eligible">The margin is under the thresholds: no commission is due.</p>
                        </page>
                        <page string="Long-distance allowances" name="igd" invisible="cost_origin != 'employee'">
                            <p class="text-muted">
                                Scale of the company (URSSAF), per day worked, copied here: edit it for this mission only,
                                the reference of the company does not change. Tick the lodging and the meals above.
                            </p>
                            <field name="igd_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="month_from"/>
                                    <field name="month_to"/>
                                    <field name="meal"/>
                                    <field name="lodging"/>
                                    <field name="total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <button name="action_reset_igd_scale" type="object" class="btn-secondary"
                                    string="Restore the scale of the company"
                                    confirm="The rates of this mission go back to the scale of the company."/>
                        </page>
                        <page string="Billing forecast" name="forecast">
                            <group>
                                <field name="start_date"/>
                            </group>
                            <button name="action_generate_months" type="object" string="Generate the months"
                                    class="btn-secondary"/>
                            <field name="month_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="leave_days"/>
                                    <field name="working_days"/>
                                    <field name="revenue" sum="Total"/>
                                    <field name="margin" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="mission_margin_action" model="ir.actions.act_window">
        <field name="name">Margin calculations</field>
        <field name="res_model">mission.margin</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a margin calculation</p>
            <p>Work out the margin of a mission before the order: cost of the consultant, daily rate,
               commissions and billing forecast. Attach it to a project now and to the order later.</p>
        </field>
    </record>

    <menuitem id="menu_mission_margin_sale" name="Margin calculations"
              parent="sale.sale_order_menu" action="mission_margin_action" sequence="25"
              groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager"/>
    <menuitem id="menu_mission_margin_project" name="Margin calculations"
              parent="project.menu_main_pm" action="mission_margin_action" sequence="25"
              groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager"/>

    <!-- The sheet from the project and from the order. -->
    <record id="project_form_draft" model="ir.ui.view">
        <field name="name">project.project.form.draft</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="mission_draft" invisible="1"/>
                <widget name="web_ribbon" title="Draft" bg_color="text-bg-warning" invisible="not mission_draft"/>
            </xpath>
        </field>
    </record>

    <record id="project_search_draft" model="ir.ui.view">
        <field name="name">project.project.search.draft</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="mission_draft" string="Drafts (order not confirmed)" domain="[('mission_draft', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="project_list_draft" model="ir.ui.view">
        <field name="name">project.project.list.draft</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="mission_draft" widget="boolean" string="Draft" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="project_form_margin" model="ir.ui.view">
        <field name="name">project.project.form.margin</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_margins" type="object" class="oe_stat_button" icon="fa-calculator"
                        groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager">
                    <field name="margin_count" widget="statinfo" string="Margin"/>
                </button>
            </div>
        </field>
    </record>

    <record id="sale_order_form_margin" model="ir.ui.view">
        <field name="name">sale.order.form.margin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_margins" type="object" class="oe_stat_button" icon="fa-calculator"
                        groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager"
                        invisible="margin_count == 0">
                    <field name="margin_count" widget="statinfo" string="Margin"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
