<odoo>
    <record id="mission_margin_view_list" model="ir.ui.view">
        <field name="name">mission.margin.list</field>
        <field name="model">mission.margin</field>
        <field name="arch" type="xml">
            <list string="Margin calculations">
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="consultant" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="daily_rate" optional="show"/>
                <field name="margin_month" optional="show"/>
                <field name="margin_rate" widget="percentage" optional="show"/>
                <field name="margin_duration" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="mission_margin_view_search" model="ir.ui.view">
        <field name="name">mission.margin.search</field>
        <field name="model">mission.margin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="consultant"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="order_id"/>
                <filter name="without_order" string="Without order" domain="[('order_id', '=', False)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mission_margin_view_form" model="ir.ui.view">
        <field name="name">mission.margin.form</field>
        <field name="model">mission.margin</field>
        <field name="arch" type="xml">
            <form string="Margin calculation">
                <field name="currency_id" invisible="1"/>
                <field name="active" invisible="1"/>
                <header>
                    <button name="action_create_project" type="object" string="Create the project"
                            invisible="project_id"/>
                    <button name="action_create_order" type="object" string="Create the quote"
                            class="oe_highlight" invisible="order_id or not partner_id"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_project" type="object" class="oe_stat_button"
                                icon="fa-puzzle-piece" invisible="not project_id">
                            <div class="o_stat_info"><span class="o_stat_text">Project</span></div>
                        </button>
                        <button name="action_open_order" type="object" class="oe_stat_button"
                                icon="fa-dollar" invisible="not order_id">
                            <div class="o_stat_info"><span class="o_stat_text">Order</span></div>
                        </button>
                        <button name="action_open_profitability" type="object" class="oe_stat_button"
                                icon="fa-line-chart" invisible="not project_id"
                                groups="project.group_project_user">
                            <div class="o_stat_info"><span class="o_stat_text">Actual profitability</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Customer - Consultant"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="consultant"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="order_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <group>
                        <group string="The consultant">
                            <field name="cost_origin" widget="radio" options="{'horizontal': true}"/>
                            <field name="salary_preset" invisible="cost_origin != 'employee'"/>
                            <field name="gross_salary" string="Exact gross amount"
                                   invisible="cost_origin != 'employee'"/>
                            <field name="freelance_daily_rate" invisible="cost_origin != 'freelance'"/>
                            <field name="daily_cost_worked" invisible="cost_origin != 'employee'"/>
                            <field name="igd_lodging" invisible="cost_origin != 'employee'"/>
                            <field name="igd_meals" widget="radio" options="{'horizontal': true}"
                                   invisible="cost_origin != 'employee'"/>
                            <field name="duration_months"/>
                        </group>
                        <group string="Price and margin">
                            <field name="margin_choice" widget="radio" options="{'horizontal': true}"/>
                            <field name="daily_rate" class="fw-bold"/>
                            <field name="rebilled_daily"/>
                            <field name="igd_rebilled" invisible="cost_origin != 'employee' or not igd_daily"/>
                            <field name="margin_rate" widget="percentage" class="fw-bold"/>
                            <field name="margin_day"/>
                            <field name="margin_month"/>
                            <field name="margin_duration" string="Margin over the mission"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Details of the costs" name="cost">
                            <group>
                                <group string="Cost of the person">
                                    <field name="employer_charge_rate" widget="percentage"
                                           invisible="cost_origin != 'employee'"/>
                                    <field name="payslip_monthly_cost" invisible="cost_origin != 'employee'"/>
                                    <field name="overhead_rate" widget="percentage"/>
                                    <field name="base_cost"/>
                                    <field name="overhead_cost"/>
                                    <field name="loaded_cost"/>
                                </group>
                                <group string="Days worked">
                                    <field name="weekend_days"/>
                                    <field name="public_holidays"/>
                                    <field name="paid_leave_days"/>
                                    <field name="rtt_days"/>
                                    <field name="days_per_year"/>
                                    <field name="days_per_month"/>
                                </group>
                            </group>
                            <group>
                                <group string="Other costs">
                                    <field name="daily_cost_calendar" invisible="cost_origin != 'employee'"/>
                                    <field name="mileage_monthly" invisible="cost_origin != 'employee'"/>
                                    <field name="expenses_monthly" invisible="cost_origin != 'employee'"/>
                                    <field name="training_yearly" invisible="cost_origin != 'employee'"/>
                                    <field name="ppe_yearly" invisible="cost_origin != 'employee'"/>
                                    <field name="equipment_yearly" invisible="cost_origin != 'employee'"/>
                                    <field name="other_yearly"/>
                                    <field name="igd_daily" invisible="cost_origin != 'employee'"/>
                                    <field name="other_costs"/>
                                </group>
                                <group string="Total">
                                    <field name="total_cost"/>
                                    <field name="total_cost_month"/>
                                    <field name="cost_per_day"/>
                                    <field name="revenue"/>
                                    <field name="price_per_day"/>
                                    <field name="margin"/>
                                </group>
                            </group>
                            <group string="Daily rate (TJM) to reach a target margin">
                                <group>
                                    <field name="target_amount_1"/>
                                    <field name="rate_target_1" string="Daily rate"/>
                                    <field name="target_amount_2"/>
                                    <field name="rate_target_2" string="Daily rate"/>
                                </group>
                                <group>
                                    <field name="target_rate_1" widget="percentage"/>
                                    <field name="rate_target_rate_1" string="Daily rate"/>
                                    <field name="target_rate_2" widget="percentage"/>
                                    <field name="rate_target_rate_2" string="Daily rate"/>
                                </group>
                            </group>
                        </page>
                        <page string="Net income" name="net" invisible="cost_origin != 'employee'">
                            <group>
                                <group string="Consultant">
                                    <field name="gross_salary" readonly="1"/>
                                    <field name="employee_charge_rate" widget="percentage"/>
                                    <field name="net_salary_month"/>
                                    <field name="net_salary_day"/>
                                    <field name="daily_fees_month"/>
                                    <field name="daily_fees_day"/>
                                    <field name="net_income_month"/>
                                    <field name="net_income_day"/>
                                    <field name="net_income_year"/>
                                </group>
                            </group>
                        </page>
                        <page string="Commissions" name="commissions">
                            <group>
                                <group string="Conditions">
                                    <field name="commission_threshold_rate" widget="percentage"/>
                                    <field name="commission_threshold_amount"/>
                                    <field name="commission_eligible"/>
                                </group>
                                <group string="Gross commission a month">
                                    <field name="commission_rate_full" widget="percentage"/>
                                    <field name="commission_full"/>
                                    <field name="commission_rate_management" widget="percentage"/>
                                    <field name="commission_management"/>
                                    <field name="commission_rate_referral" widget="percentage"/>
                                    <field name="commission_referral"/>
                                </group>
                            </group>
                            <p class="text-muted" invisible="commission_eligible">The margin is under the thresholds: no commission is due.</p>
                        </page>
                        <page string="Long-distance allowances" name="igd" invisible="cost_origin != 'employee'">
                            <p class="text-muted">Rates per day worked, by month of the mission: tick the lodging and the meals above. Update the rates when the URSSAF scale changes.</p>
                            <field name="igd_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="month_from"/>
                                    <field name="month_to"/>
                                    <field name="meal"/>
                                    <field name="lodging"/>
                                    <field name="total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Billing forecast" name="forecast">
                            <group>
                                <field name="start_date"/>
                            </group>
                            <button name="action_generate_months" type="object" string="Generate the months"
                                    class="btn-secondary"/>
                            <field name="month_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="leave_days"/>
                                    <field name="working_days"/>
                                    <field name="revenue" sum="Total"/>
                                    <field name="margin" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="mission_margin_action" model="ir.actions.act_window">
        <field name="name">Margin calculations</field>
        <field name="res_model">mission.margin</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a margin calculation</p>
            <p>Work out the margin of a mission before the order: cost of the consultant, daily rate,
               commissions and billing forecast. Attach it to a project now and to the order later.</p>
        </field>
    </record>

    <menuitem id="menu_mission_margin_sale" name="Margin calculations"
              parent="sale.sale_order_menu" action="mission_margin_action" sequence="25"
              groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager"/>
    <menuitem id="menu_mission_margin_project" name="Margin calculations"
              parent="project.menu_main_pm" action="mission_margin_action" sequence="25"
              groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager"/>

    <!-- The sheet from the project and from the order. -->
    <record id="project_form_margin" model="ir.ui.view">
        <field name="name">project.project.form.margin</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_margins" type="object" class="oe_stat_button" icon="fa-calculator"
                        groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager">
                    <field name="margin_count" widget="statinfo" string="Margin"/>
                </button>
            </div>
        </field>
    </record>

    <record id="sale_order_form_margin" model="ir.ui.view">
        <field name="name">sale.order.form.margin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_margins" type="object" class="oe_stat_button" icon="fa-calculator"
                        groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager"
                        invisible="margin_count == 0">
                    <field name="margin_count" widget="statinfo" string="Margin"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
