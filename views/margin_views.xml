<odoo>
    <record id="mission_margin_view_list" model="ir.ui.view">
        <field name="name">mission.margin.list</field>
        <field name="model">mission.margin</field>
        <field name="arch" type="xml">
            <list string="Margin calculations">
                <field name="name"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'"
                       decoration-warning="state in ('project', 'quote')" decoration-success="state == 'order'"/>
                <field name="partner_id" optional="show"/>
                <field name="consultant_id" optional="show"/>
                <field name="project_id" optional="show"/>
                <field name="order_id" optional="show"/>
                <field name="daily_rate" optional="show"/>
                <field name="order_gap_short" string="Order" optional="show" class="text-warning"/>
                <field name="margin_month" optional="show"/>
                <field name="margin_rate" widget="percentage" optional="show"
                       decoration-danger="margin_rate &lt; 0" decoration-warning="margin_rate &gt;= 0 and margin_rate &lt; 0.2"/>
                <field name="margin_duration" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="mission_margin_view_search" model="ir.ui.view">
        <field name="name">mission.margin.search</field>
        <field name="model">mission.margin</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="consultant"/>
                <field name="partner_id"/>
                <field name="project_id"/>
                <field name="order_id"/>
                <filter name="state_draft" string="Drafts" domain="[('state', 'in', ('draft', 'project'))]"/>
                <filter name="state_quote" string="Quotes" domain="[('state', '=', 'quote')]"/>
                <filter name="state_order" string="Orders" domain="[('state', '=', 'order')]"/>
                <filter name="without_order" string="Without order" domain="[('order_id', '=', False)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_project" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="mission_margin_view_form" model="ir.ui.view">
        <field name="name">mission.margin.form</field>
        <field name="model">mission.margin</field>
        <field name="arch" type="xml">
            <form string="Margin calculation" js_class="mission_margin_form">
                <field name="currency_id" invisible="1"/>
                <field name="active" invisible="1"/>
                <field name="name_auto" invisible="1"/>
                <header>
                    <button name="action_create_project" type="object" string="Create the project"
                            invisible="project_id"/>
                    <button name="action_create_order" type="object" string="Create the quote"
                            class="oe_highlight" invisible="order_id or not partner_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <div class="o_margin_stickybar d-md-none">
                    <div>
                        <div class="text-muted">Margin (%)</div>
                        <field name="margin_rate" widget="percentage" readonly="1" class="fw-bold oe_inline"/>
                    </div>
                    <div>
                        <div class="text-muted">Margin a month</div>
                        <field name="margin_month" readonly="1" class="fw-bold oe_inline"/>
                    </div>
                    <div>
                        <div class="text-muted">Daily rate sold (TJM)</div>
                        <field name="daily_rate" readonly="1" class="fw-bold oe_inline"/>
                    </div>
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_project" type="object" class="oe_stat_button"
                                icon="fa-puzzle-piece" invisible="not project_id">
                            <div class="o_stat_info"><span class="o_stat_text">Project</span></div>
                        </button>
                        <button name="action_open_order" type="object" class="oe_stat_button"
                                icon="fa-dollar" invisible="not order_id">
                            <div class="o_stat_info"><span class="o_stat_text">Order</span></div>
                        </button>
                        <button name="action_open_profitability" type="object" class="oe_stat_button"
                                icon="fa-line-chart" invisible="not project_id"
                                groups="project.group_project_user">
                            <div class="o_stat_info"><span class="o_stat_text">Actual profitability</span></div>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="order_gap" invisible="1"/>
                    <field name="order_price" invisible="1"/>
                    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-3 mb-3" role="alert"
                         invisible="not order_gap">
                        <div class="flex-grow-1"><field name="order_gap_text" class="fw-bold"/></div>
                        <button name="action_restore_order_conditions" type="object" class="btn btn-secondary"
                                string="Restore the conditions of the order"/>
                        <button name="action_open_conditions_wizard" type="object" class="btn btn-primary"
                                string="Record the change of the conditions of the deal"/>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Filled in from the customer and the consultant"/></h1>
                    </div>
                    <field name="consultant_partner_ids" invisible="1"/>
                    <group>
                        <group>
                            <field name="project_id"
                                   domain="[('partner_id', '=', partner_id)] if partner_id else []"
                                   options="{'no_create': True}"/>
                            <field name="order_id"
                                   domain="[('project_id', '=', project_id)] if project_id else ([('partner_id', '=', partner_id)] if partner_id else [])"
                                   options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="partner_id"
                                   context="{'res_partner_search_mode': 'customer', 'default_customer_rank': 1}"/>
                            <field name="consultant_id"
                                   context="{'default_category_id': [%(mission_report.partner_category_candidate)d], 'default_is_company': False}"/>
                        </group>
                    </group>

                    <field name="salary_min" invisible="1"/>
                    <field name="salary_max" invisible="1"/>
                    <field name="show_commissions" invisible="1"/>
                    <field name="rate_manual" invisible="1"/>
                    <field name="cost_per_day" invisible="1"/>
                    <field name="rebilled_total" invisible="1"/>
                    <group>
                        <group string="The consultant">
                            <field name="cost_origin" widget="radio" options="{'horizontal': true}"/>
                            <div colspan="2" invisible="cost_origin != 'employee'">
                                <field name="gross_salary" widget="salary_slider" nolabel="1"
                                       decoration-muted="payslip_monthly_cost"/>
                            </div>
                            <field name="gross_salary" invisible="cost_origin != 'employee' or payslip_monthly_cost"/>
                            <field name="gross_salary" class="text-muted"
                                   invisible="cost_origin != 'employee' or not payslip_monthly_cost"
                                   help="The monthly total cost (payslip) takes precedence over the salary in the profitability calculation: this amount is only informative."/>
                            <field name="freelance_daily_rate" invisible="cost_origin != 'freelance'"/>
                            <label for="igd_lodging" string="Allowances per day worked"
                                   invisible="cost_origin != 'employee'"/>
                            <div class="o_margin_checks" invisible="cost_origin != 'employee'">
                                <div class="o_margin_check">
                                    <field name="igd_lunch" nolabel="1"/><label for="igd_lunch"/>
                                    <field name="igd_meal_basis" nolabel="1" class="o_margin_basis"
                                           invisible="not (igd_lunch or igd_dinner)"/>
                                </div>
                                <div class="o_margin_check">
                                    <field name="igd_dinner" nolabel="1"/><label for="igd_dinner"/>
                                </div>
                                <div class="o_margin_check">
                                    <field name="igd_lodging" nolabel="1"/><label for="igd_lodging"/>
                                    <field name="igd_lodging_basis" nolabel="1" class="o_margin_basis"
                                           invisible="not igd_lodging"/>
                                </div>
                                <div class="o_margin_check">
                                    <field name="igd_expat" nolabel="1"/><label for="igd_expat"/>
                                    <div class="o_margin_check_more"
                                         invisible="not igd_expat">
                                        <field name="igd_expat_amount" nolabel="1" class="o_margin_amount"
                                               placeholder="per day"/>
                                        <field name="igd_expat_basis" nolabel="1" class="o_margin_basis"/>
                                    </div>
                                </div>
                            </div>
                            <field name="igd_scale_choice" invisible="cost_origin != 'employee'
                                   or not (igd_lodging or igd_lunch or igd_dinner)"/>
                            <label for="igd_daily" string="Allowances total"
                                   invisible="cost_origin != 'employee' or not igd_daily"/>
                            <div class="o_margin_inline fw-bold" invisible="cost_origin != 'employee' or not igd_daily">
                                <field name="igd_daily"/><div class="fw-normal text-muted">a day</div>
                                <div class="text-muted">&#183;</div>
                                <field name="igd_month"/><div class="fw-normal text-muted">a month</div>
                            </div>
                            <label for="daily_cost_worked" invisible="cost_origin != 'employee'"/>
                            <div class="d-flex gap-2" invisible="cost_origin != 'employee'">
                                <field name="daily_cost_worked" class="o_margin_amount"/>
                                <field name="daily_cost_reason" placeholder="Reason" class="flex-grow-1"/>
                            </div>
                            <label for="fixed_monthly_amount" invisible="cost_origin != 'employee'"/>
                            <div class="d-flex gap-2" invisible="cost_origin != 'employee'">
                                <field name="fixed_monthly_amount" class="o_margin_amount"/>
                                <field name="fixed_monthly_reason" placeholder="Reason" class="flex-grow-1"/>
                            </div>
                            <field name="duration_months"/>
                            <field name="mission_days" placeholder="Full time" invisible="billing_mode == 'forfait'"/>
                            <field name="mission_days" string="Days estimated for the work" placeholder="Number of days"
                                   invisible="billing_mode != 'forfait'" required="billing_mode == 'forfait'"/>
                        </group>
                        <group string="Price and margin">
                            <field name="billing_mode" widget="radio" options="{'horizontal': true}"/>
                            <div class="text-muted" colspan="2" invisible="billing_mode != 'regie'">
                                Time and materials (régie): the customer pays each day worked at the daily rate. The price follows the time spent: a longer mission is billed more.
                            </div>
                            <div class="text-muted" colspan="2" invisible="billing_mode != 'forfait'">
                                Fixed price (forfait): you sell a price for a result, whatever the time spent. If the work needs more days than planned, the margin falls: the risk is yours, so estimate the days with care.
                            </div>
                            <div colspan="2"><field name="margin_wanted" widget="margin_slider" nolabel="1"/></div>
                            <label for="margin_rate"/>
                            <div class="d-flex align-items-baseline gap-4">
                                <field name="margin_rate" widget="percentage" class="fw-bold oe_inline"
                                       decoration-danger="margin_rate &lt; 0"
                                       decoration-warning="margin_rate &gt;= 0 and margin_rate &lt; commission_threshold_rate"/>
                                <field name="margin_month" class="fw-bold oe_inline"
                                       decoration-danger="margin_month &lt; 0"
                                       decoration-warning="margin_month &gt;= 0 and margin_month &lt; commission_threshold_amount"/>
                            </div>
                            <div colspan="2"><field name="daily_rate" widget="rate_slider" nolabel="1"/></div>
                            <label for="fixed_price" invisible="billing_mode != 'forfait'"/>
                            <div class="d-flex flex-wrap align-items-baseline gap-3" invisible="billing_mode != 'forfait'">
                                <field name="fixed_price" class="fw-bold oe_inline"/>
                                <field name="order_gap_short" class="text-warning fw-bold oe_inline"
                                       invisible="not order_gap"/>
                            </div>
                            <label for="daily_rate" invisible="billing_mode == 'forfait'"/>
                            <div class="d-flex flex-wrap align-items-baseline gap-3" invisible="billing_mode == 'forfait'">
                                <field name="daily_rate" class="fw-bold oe_inline"/>
                                <field name="order_gap_short" class="text-warning fw-bold oe_inline"
                                       invisible="not order_gap"/>
                            </div>
                            <field name="daily_rate" string="Equivalent daily rate" invisible="billing_mode != 'forfait'"/>
                            <field name="breakeven_days" invisible="billing_mode != 'forfait'"/>
                            <label for="target_rate_2" string="Indicative daily rate" class="text-muted"/>
                            <div class="o_margin_indicative d-flex flex-nowrap align-items-center gap-1 text-muted">
                                <field name="target_rate_2" widget="percentage" class="o_margin_pct"/>
                                <div>&#8594;</div>
                                <field name="rate_target_rate_2" widget="rate_pick"/>
                                <field name="target_amount_2" class="o_margin_amount ms-2"/>
                                <div>&#8594;</div>
                                <field name="rate_target_2" widget="rate_pick"/>
                            </div>
                            <label for="rebilled_daily"/>
                            <div class="d-flex gap-2">
                                <field name="rebilled_daily" class="o_margin_amount"/>
                                <field name="rebilled_daily_note" placeholder="Note" class="flex-grow-1"/>
                            </div>
                            <label for="rebilled_monthly"/>
                            <div class="d-flex gap-2">
                                <field name="rebilled_monthly" class="o_margin_amount"/>
                                <field name="rebilled_monthly_note" placeholder="Note" class="flex-grow-1"/>
                            </div>
                            <field name="igd_rebilled" invisible="cost_origin != 'employee' or not igd_daily"/>
                        </group>
                    </group>

                    <group string="Breakdown of the monthly revenue">
                        <field name="breakdown" widget="margin_donut" nolabel="1" colspan="2"/>
                    </group>

                    <notebook>
                        <page string="Details of the costs" name="cost">
                            <group>
                                <group string="Other mission charges">
                                    <label for="other_worked_daily"/>
                                    <div class="d-flex gap-2">
                                        <field name="other_worked_daily" class="o_margin_amount"/>
                                        <field name="other_worked_daily_note" placeholder="Note" class="flex-grow-1"/>
                                    </div>
                                    <label for="daily_cost_calendar"/>
                                    <div class="d-flex gap-2">
                                        <field name="daily_cost_calendar" class="o_margin_amount"/>
                                        <field name="daily_cost_calendar_note" placeholder="Note" class="flex-grow-1"/>
                                    </div>
                                    <label for="expenses_monthly"/>
                                    <div class="d-flex gap-2">
                                        <field name="expenses_monthly" class="o_margin_amount"/>
                                        <field name="expenses_monthly_note" placeholder="Note" class="flex-grow-1"/>
                                    </div>
                                    <label for="mileage_monthly" invisible="cost_origin != 'employee'"/>
                                    <div class="d-flex gap-2" invisible="cost_origin != 'employee'">
                                        <field name="mileage_monthly" class="o_margin_amount"/>
                                        <field name="mileage_monthly_note" placeholder="Note" class="flex-grow-1"/>
                                    </div>
                                    <label for="training_yearly" invisible="cost_origin != 'employee'"/>
                                    <div class="d-flex gap-2" invisible="cost_origin != 'employee'">
                                        <field name="training_yearly" class="o_margin_amount"/>
                                        <field name="training_yearly_note" placeholder="Note" class="flex-grow-1"/>
                                    </div>
                                    <label for="ppe_yearly" invisible="cost_origin != 'employee'"/>
                                    <div class="d-flex gap-2" invisible="cost_origin != 'employee'">
                                        <field name="ppe_yearly" class="o_margin_amount"/>
                                        <field name="ppe_yearly_note" placeholder="Note" class="flex-grow-1"/>
                                    </div>
                                    <label for="equipment_yearly" invisible="cost_origin != 'employee'"/>
                                    <div class="d-flex gap-2" invisible="cost_origin != 'employee'">
                                        <field name="equipment_yearly" class="o_margin_amount"/>
                                        <field name="equipment_yearly_note" placeholder="Note" class="flex-grow-1"/>
                                    </div>
                                    <label for="other_yearly"/>
                                    <div class="d-flex gap-2">
                                        <field name="other_yearly" class="o_margin_amount"/>
                                        <field name="other_yearly_note" placeholder="Note" class="flex-grow-1"/>
                                    </div>
                                    <field name="other_costs"/>
                                </group>
                                <group string="Total">
                                    <field name="mission_days_total"/>
                                    <field name="mission_cost"/>
                                    <field name="mission_revenue"/>
                                    <field name="margin_duration" string="Margin over the mission" class="fw-bold"/>
                                    <field name="cost_per_day" string="Total cost per worked day"/>
                                    <field name="price_per_day"/>
                                    <field name="margin_day"/>
                                    <field name="total_cost_month"/>
                                </group>
                            </group>
                            <group>
                                <group string="Pay and charges">
                                    <field name="employer_charge_rate" widget="percentage" class="o_margin_pct text-muted"
                                           invisible="cost_origin != 'employee'"/>
                                    <field name="payslip_monthly_cost" invisible="cost_origin != 'employee'"/>
                                    <field name="overhead_rate" widget="percentage" class="o_margin_pct text-muted"/>
                                    <field name="base_cost"/>
                                    <field name="overhead_cost"/>
                                    <field name="loaded_cost"/>
                                </group>
                                <group string="Days worked">
                                    <field name="weekend_days"/>
                                    <field name="public_holidays"/>
                                    <field name="paid_leave_days"/>
                                    <field name="rtt_days"/>
                                    <field name="days_per_year"/>
                                    <field name="days_per_month"/>
                                </group>
                            </group>
                        </page>
                        <page string="Net income" name="net" invisible="cost_origin != 'employee'">
                            <group>
                                <group string="Consultant">
                                    <field name="gross_used"/>
                                    <field name="employee_charge_rate" widget="percentage" class="o_margin_pct text-muted"/>
                                    <field name="net_salary_month"/>
                                    <field name="net_salary_day"/>
                                    <field name="daily_fees_month"/>
                                    <field name="daily_fees_day"/>
                                    <field name="net_income_month"/>
                                    <field name="net_income_day"/>
                                    <field name="net_income_year"/>
                                </group>
                            </group>
                        </page>
                        <page string="Commissions" name="commissions" invisible="not show_commissions">
                            <group col="3" class="o_margin_commissions">
                                <group string="Conditions">
                                    <field name="commission_rule_id" options="{'no_create': True, 'no_open': True}"/>
                                    <field name="commission_threshold_rate" widget="percentage" class="o_margin_pct text-muted"/>
                                    <field name="commission_threshold_amount" class="text-muted"/>
                                    <field name="commission_cap" widget="percentage" class="o_margin_pct text-muted"/>
                                    <field name="commission_eligible"/>
                                </group>
                                <group string="Gross commission a month">
                                    <label for="commission_sourcing"/>
                                    <div class="d-flex align-items-center gap-2">
                                        <field name="commission_rate_sourcing" widget="percentage" class="o_margin_pct text-muted"/>
                                        <div>&#8594;</div>
                                        <field name="commission_sourcing" class="oe_inline fw-bold"/>
                                    </div>
                                    <label for="commission_referral"/>
                                    <div class="d-flex align-items-center gap-2">
                                        <field name="commission_rate_referral" widget="percentage" class="o_margin_pct text-muted"/>
                                        <div>&#8594;</div>
                                        <field name="commission_referral" class="oe_inline fw-bold"/>
                                    </div>
                                    <label for="commission_candidate"/>
                                    <div class="d-flex align-items-center gap-2">
                                        <field name="commission_rate_candidate" widget="percentage" class="o_margin_pct text-muted"/>
                                        <div>&#8594;</div>
                                        <field name="commission_candidate" class="oe_inline fw-bold"/>
                                    </div>
                                    <label for="commission_client"/>
                                    <div class="d-flex align-items-center gap-2">
                                        <field name="commission_rate_client" widget="percentage" class="o_margin_pct text-muted"/>
                                        <div>&#8594;</div>
                                        <field name="commission_client" class="oe_inline fw-bold"/>
                                    </div>
                                    <label for="commission_full"/>
                                    <div class="d-flex align-items-center gap-2">
                                        <field name="commission_rate_full" widget="percentage" class="o_margin_pct text-muted"/>
                                        <div>&#8594;</div>
                                        <field name="commission_full" class="oe_inline fw-bold"/>
                                    </div>
                                </group>
                                <group string="Partner commission a month"
                                       groups="mission_report.group_mission_partner">
                                    <label for="commission_team"/>
                                    <div class="d-flex align-items-center gap-2">
                                        <field name="commission_rate_team" widget="percentage" class="o_margin_pct text-muted"/>
                                        <div>&#8594;</div>
                                        <field name="commission_team" class="oe_inline fw-bold"/>
                                    </div>
                                </group>
                            </group>
                            <p class="text-muted" invisible="commission_eligible">The margin is under the thresholds: no commission is due.</p>
                            <p class="text-muted">
                                Based on the forecast gross margin, or on the actual one when it is lower, over whole
                                months only: the first and the last months, if incomplete, give no commission. The roles
                                add up, within the cap of the company.
                            </p>
                        </page>
                        <page string="Long-distance allowances" name="igd" invisible="cost_origin != 'employee'">
                            <p class="text-muted">
                                Scale of the company (URSSAF), per day worked, copied here: edit it for this mission only,
                                the reference of the company does not change. Tick the lodging and the meals above.
                            </p>
                            <field name="igd_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="label"/>
                                    <field name="month_from"/>
                                    <field name="month_to"/>
                                    <field name="meal"/>
                                    <field name="lodging"/>
                                    <field name="total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <button name="action_reset_igd_scale" type="object" class="btn-secondary"
                                    string="Restore the scale of the company"
                                    confirm="The rates of this mission go back to the scale of the company."/>
                        </page>
                        <page string="Billing forecast" name="forecast">
                            <group>
                                <field name="start_date"/>
                            </group>
                            <p class="text-muted" invisible="month_ids">
                                Choose the start of the mission, then generate the months: each one gets its working days
                                (or the days planned for a mission by the day) and its billing and margin.
                            </p>
                            <button name="action_generate_months" type="object" string="Generate the months"
                                    class="btn-secondary"/>
                            <field name="month_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="days_planned" column_invisible="not parent.mission_days"/>
                                    <field name="leave_days" column_invisible="parent.mission_days"/>
                                    <field name="working_days"/>
                                    <field name="revenue" sum="Total"/>
                                    <field name="margin" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Context of the mission, assumptions of the calculation, what was agreed..."/>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="mission_margin_condition_wizard_view_form" model="ir.ui.view">
        <field name="name">mission.margin.condition.wizard.form</field>
        <field name="model">mission.margin.condition.wizard</field>
        <field name="arch" type="xml">
            <form string="Change of the conditions of the deal">
                <field name="currency_id" invisible="1"/>
                <field name="note_required" invisible="1"/>
                <p class="text-muted">
                    The conditions of the order change to those of the calculation. They are not changed by
                    themselves once the order is confirmed: say why, so the history of the deal keeps it.
                </p>
                <group>
                    <group>
                        <field name="margin_id" invisible="1"/>
                        <field name="order_id"/>
                        <field name="old_price"/>
                        <field name="new_price" class="fw-bold"/>
                    </group>
                    <group>
                        <field name="reason" widget="radio"/>
                    </group>
                </group>
                <field name="note" placeholder="What was agreed, with whom, and why..."
                       required="note_required"/>
                <footer>
                    <button name="action_confirm" type="object" string="Record the change" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="mission_margin_action" model="ir.actions.act_window">
        <field name="name">Margin calculations</field>
        <field name="res_model">mission.margin</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a margin calculation</p>
            <p>Work out the margin of a mission before the order: cost of the consultant, daily rate,
               commissions and billing forecast. Attach it to a project now and to the order later.</p>
        </field>
    </record>

    <menuitem id="menu_mission_margin_sale" name="Margin calculations"
              parent="sale.sale_order_menu" action="mission_margin_action" sequence="25"
              groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager"/>
    <menuitem id="menu_mission_margin_project" name="Margin calculations"
              parent="project.menu_main_pm" action="mission_margin_action" sequence="25"
              groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager"/>

    <!-- The sheet from the project and from the order. -->
    <record id="project_form_draft" model="ir.ui.view">
        <field name="name">project.project.form.draft</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <field name="mission_draft" invisible="1"/>
                <widget name="web_ribbon" title="Draft" bg_color="text-bg-warning" invisible="not mission_draft"/>
            </xpath>
        </field>
    </record>

    <record id="project_search_draft" model="ir.ui.view">
        <field name="name">project.project.search.draft</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_project_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="mission_draft" string="Drafts (order not confirmed)" domain="[('mission_draft', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <record id="project_list_draft" model="ir.ui.view">
        <field name="name">project.project.list.draft</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="mission_draft" widget="boolean" string="Draft" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="project_form_margin" model="ir.ui.view">
        <field name="name">project.project.form.margin</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_margins" type="object" class="oe_stat_button" icon="fa-calculator"
                        groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager">
                    <field name="margin_count" widget="statinfo" string="Margin"/>
                </button>
            </div>
        </field>
    </record>

    <record id="sale_order_form_margin" model="ir.ui.view">
        <field name="name">sale.order.form.margin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_margins" type="object" class="oe_stat_button" icon="fa-calculator"
                        groups="sales_team.group_sale_salesman,project.group_project_manager,hr.group_hr_manager"
                        invisible="margin_count == 0">
                    <field name="margin_count" widget="statinfo" string="Margin"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
