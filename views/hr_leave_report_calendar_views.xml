<odoo>
    <!-- Activité > Vue d'ensemble.
         Cet écran ne repose pas sur hr.leave mais sur hr.leave.report.calendar,
         une vue SQL construite au-dessus : les renommages faits sur hr.leave ne
         l'atteignent pas, et tout son vocabulaire était resté celui des congés. -->

    <!-- La vue d'ensemble s'ouvre sur l'année ; le mois est un clic plus loin. Chacun
         retrouve ensuite l'échelle qu'il a choisie en dernier. -->
    <record id="hr_holidays.hr_leave_report_calendar_year_view" model="ir.ui.view">
        <field name="priority">10</field>
    </record>
    <record id="hr_holidays.hr_leave_report_calendar_view" model="ir.ui.view">
        <field name="priority">20</field>
    </record>

    <!-- Calendrier mensuel -->
    <record id="hr_leave_report_calendar_view_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.report.calendar.view.inherit.mission.report</field>
        <field name="model">hr.leave.report.calendar</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_report_calendar_view"/>
        <field name="arch" type="xml">
            <!-- Couleur par type de saisie : les missions (type « Activité ») d'une
                 couleur, chaque type de congé d'une autre ; le nom dit qui. -->
            <xpath expr="//calendar" position="attributes">
                <attribute name="string">Entries</attribute>
                <attribute name="color">holiday_status_id</attribute>
                <!-- Un jour ou une plage cliqués créent une saisie (voir overview_calendar.js). -->
                <attribute name="create">1</attribute>
            </xpath>
            <!-- Journée de travail du salarié : la barre d'une demi-journée ou d'heures s'y place. -->
            <xpath expr="//calendar" position="inside">
                <field name="mission_day_start" invisible="1"/>
                <field name="mission_day_end" invisible="1"/>
            </xpath>
        </field>
    </record>

    <!-- Calendrier annuel -->
    <record id="hr_leave_report_calendar_year_view_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.report.calendar.year.view.inherit.mission.report</field>
        <field name="model">hr.leave.report.calendar</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_report_calendar_year_view"/>
        <field name="arch" type="xml">
            <!-- Couleur par type de saisie : les missions (type « Activité ») d'une
                 couleur, chaque type de congé d'une autre ; le nom dit qui. -->
            <xpath expr="//calendar" position="attributes">
                <attribute name="string">Entries</attribute>
                <attribute name="color">holiday_status_id</attribute>
                <attribute name="create">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- Popup ouverte en cliquant sur une saisie du calendrier -->
    <record id="hr_leave_report_calendar_view_form_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.report.calendar.view.form.inherit.mission.report</field>
        <field name="model">hr.leave.report.calendar</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_report_calendar_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="string">Entry</attribute>
            </xpath>
            <!-- Un ruban d'état aussi pour une saisie soumise, en attente d'approbation. -->
            <xpath expr="//widget[@name='web_ribbon']" position="before">
                <widget name="web_ribbon" title="Submitted" bg_color="text-bg-warning"
                        invisible="state not in ('confirm', 'validate1')"/>
            </xpath>
            <!-- Modifier (fiche complète) ; supprimer, seulement une saisie refusée ou annulée. -->
            <xpath expr="//footer" position="inside">
                <button name="action_mission_edit" string="Edit" type="object" close="1"
                        invisible="state != 'confirm'"/>
                <button name="action_mission_reopen" string="Reopen to edit" type="object" close="1"
                        invisible="state not in ('validate1', 'validate')"
                        confirm="This entry is approved. To change it, it goes back to waiting for approval; once changed, you can approve it again. Continue?"/>
                <button name="action_mission_delete" string="Delete" type="object" close="1"
                        class="btn-danger ms-auto" invisible="state not in ('refuse', 'cancel')"
                        confirm="Delete this entry permanently?"/>
            </xpath>
            <!-- "Type de congés" : le type vaut "Activity" pour une mission. -->
            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <attribute name="string">Type of entry</attribute>
            </xpath>
        </field>
    </record>

    <!-- Barre de recherche -->
    <record id="hr_leave_report_calendar_view_search_inherit_mission_report" model="ir.ui.view">
        <field name="name">hr.leave.report.calendar.view.search.inherit.mission.report</field>
        <field name="model">hr.leave.report.calendar</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_report_calendar_view_search"/>
        <field name="arch" type="xml">
            <!-- Le filtre porte sur is_absent, vrai pour un congé comme pour une
                 activité : "Absent aujourd'hui" décrivait mal ce qu'il liste. -->
            <xpath expr="//filter[@name='off_today']" position="attributes">
                <attribute name="string">Entry in progress today</attribute>
                <attribute name="help">Employees with an entry in progress today</attribute>
            </xpath>
            <xpath expr="//filter[@name='groupby_time_off_type']" position="attributes">
                <attribute name="string">Type of entry</attribute>
            </xpath>
        </field>
    </record>

    <!-- Nom de l'action : c'est lui qui s'affiche dans le fil d'Ariane, pas le
         libellé du menu. -->
    <record id="hr_holidays.action_hr_holidays_dashboard" model="ir.actions.act_window">
        <field name="name">Vue d'ensemble</field>
        <!-- Ni « Approuvé » ni « En attente de validation » d'office : tout s'affiche, l'équipe
             et l'année restent choisies. -->
        <field name="context">{'hide_employee_name': 1, 'search_default_my_team': 1, 'search_default_current_year': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nobody here? Everybody is at work during this period.
            </p>
        </field>
    </record>
</odoo>
