<odoo>
    <!-- Affaire : destinataires des factures et modèle Excel des frais. -->
    <record id="view_order_form_mission_invoicing" model="ir.ui.view">
        <field name="name">sale.order.form.mission.invoicing</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_information']" position="inside">
                <group name="mission_invoicing" string="Envoi des factures">
                    <field name="mission_invoice_partner_ids" widget="many2many_tags_email"
                           context="{'show_email': True}"/>
                </group>
            </xpath>
            <!-- Période de l'affaire, sous le projet : plusieurs affaires peuvent se
                 succéder sur une même mission. -->
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="mission_date_start" invisible="not project_id"/>
                <field name="mission_date_end" invisible="not project_id"/>
                <!-- Unité de facturation : journées ou heures validées. -->
                <field name="mission_billing_unit" widget="radio" options="{'horizontal': true}"/>
            </xpath>
            <!-- Lignes de prestation dans une autre unité que celle de l'affaire : averti, pas bloqué. -->
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="alert alert-warning" role="alert" invisible="not mission_unit_warning">
                    <field name="mission_unit_warning"/>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Facture : mois concerné. -->
    <record id="view_move_form_mission_month" model="ir.ui.view">
        <field name="name">account.move.form.mission.month</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="(//field[@name='invoice_date'])[1]" position="after">
                <field name="mission_month" options="{'min_precision': 'months', 'max_precision': 'years'}"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>
</odoo>
