#. module: mission_report
#: model:mail.template,body_html:mission_report.mail_template_invoice_mission
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"    <p>Hello,</p>\n"
"    <p>\n"
"        Please find attached the invoice <t t-out=\"object.name or ''\"/>\n"
"        for the service <t t-out=\"object.mission_mail_object(short=True)\"/>,\n"
"        for the month of <t t-out=\"object.mission_month_label()\"/>:\n"
"    </p>\n"
"    <p t-foreach=\"object.mission_mail_days_text()\" t-as=\"days_line\"><t t-out=\"days_line\"/></p>\n"
"    <p>Together with the activity report, the table of expenses and the receipts.</p>\n"
"    <p>With our best regards,</p>\n"
"    <div t-if=\"not is_html_empty(user.signature)\"><t t-out=\"user.signature\"/></div>\n"
"</div>\n"
"        "
msgstr "<div style=\"margin: 0px; padding: 0px;\">\n    <p>Bonjour,</p>\n    <p>\n        Veuillez trouver en attachement la facture <t t-out=\"object.name or ''\"/>\n        de la prestation <t t-out=\"object.mission_mail_object(short=True)\"/>,\n        pour le mois de <t t-out=\"object.mission_month_label()\"/> :\n    </p>\n    <p t-foreach=\"object.mission_mail_days_text()\" t-as=\"days_line\"><t t-out=\"days_line\"/></p>\n    <p>Ainsi que le compte rendu d’activité, le tableau des frais et les justificatifs.</p>\n    <p>Vous en souhaitant bonne réception,</p>\n    <div t-if=\"not is_html_empty(user.signature)\"><t t-out=\"user.signature\"/></div>\n</div>\n        "

