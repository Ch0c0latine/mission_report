<odoo>
    <!-- The partners (associates) of the company: they see every commission status and the commission of the
         services managed by the collaborators. The others (account managers) only see their own statuses. -->
    <record id="res_groups_privilege_margin" model="res.groups.privilege">
        <field name="name">Margin calculations</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>
    <record id="group_mission_partner" model="res.groups">
        <field name="name">Partner (associate)</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_margin"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Sees every commission status of the margin calculations, and the commission of the services managed by the collaborators.</field>
    </record>
    <record id="rule_mission_commission_rule_group" model="ir.rule">
        <field name="name">Commission status: only the ones offered to the groups of the user</field>
        <field name="model_id" ref="model_mission_commission_rule"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">['|', ('group_id', '=', False), ('group_id', 'in', user.group_ids.ids)]</field>
    </record>
    <record id="rule_mission_commission_rule_system" model="ir.rule">
        <field name="name">Commission status: the administrators see them all</field>
        <field name="model_id" ref="model_mission_commission_rule"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <!-- A salesperson sees the margin calculations they made (salaries and costs inside); the sales managers,
         the project managers and the HR managers see them all. The rules of the groups add up. -->
    <record id="rule_mission_margin_own" model="ir.rule">
        <field name="name">Margin calculation: the salesperson sees their own</field>
        <field name="model_id" ref="model_mission_margin"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_mission_margin_all" model="ir.rule">
        <field name="name">Margin calculation: the managers see all of them</field>
        <field name="model_id" ref="model_mission_margin"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('project.group_project_manager')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_mission_margin_month_own" model="ir.rule">
        <field name="name">Margin calculation, month: the salesperson sees their own</field>
        <field name="model_id" ref="model_mission_margin_month"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('margin_id.create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_mission_margin_month_all" model="ir.rule">
        <field name="name">Margin calculation, month: the managers see all of them</field>
        <field name="model_id" ref="model_mission_margin_month"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('project.group_project_manager')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_mission_margin_igd_own" model="ir.rule">
        <field name="name">Margin calculation, allowances: the salesperson sees their own</field>
        <field name="model_id" ref="model_mission_margin_igd"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="domain_force">[('margin_id.create_uid', '=', user.id)]</field>
    </record>
    <record id="rule_mission_margin_igd_all" model="ir.rule">
        <field name="name">Margin calculation, allowances: the managers see all of them</field>
        <field name="model_id" ref="model_mission_margin_igd"/>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_manager')), (4, ref('project.group_project_manager')), (4, ref('hr.group_hr_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
